 COPY docker-entrypoint.sh /usr/local/bin/
 ENTRYPOINT ["docker-entrypoint.sh"]
diff --git a/24/trixie/Dockerfile b/24/trixie/Dockerfile
index 8da82ec2..98811f53 100644
--- a/24/trixie/Dockerfile
+++ b/24/trixie/Dockerfile
