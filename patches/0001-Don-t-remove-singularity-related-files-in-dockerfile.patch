From 87beea090d71adc11a82cecc8bc8b618a28fdf23 Mon Sep 17 00:00:00 2001
From: Grzegorz Placzek <gplaczek@antmicro.com>
Date: Thu, 15 Oct 2026 11:37:45 +0200
Subject: [PATCH] Don't remove singularity-related files in dockerfiles

---
 24/alpine3.23/Dockerfile    | 4 ++--
 24/alpine3.24/Dockerfile    | 4 ++--
 24/bookworm-slim/Dockerfile | 4 ++--
 24/bookworm/Dockerfile      | 4 ++--
 24/trixie-slim/Dockerfile   | 4 ++--
 24/trixie/Dockerfile        | 4 ++--
 6 files changed, 12 insertions(+), 12 deletions(-)

diff --git a/24/alpine3.23/Dockerfile b/24/alpine3.23/Dockerfile
index 182a4555..cccceb35 100644
--- a/24/alpine3.23/Dockerfile
+++ b/24/alpine3.23/Dockerfile
@@ -77,7 +77,7 @@ RUN addgroup -g 1000 node \
   # smoke tests
   && node --version \
   && npm --version \
-  && rm -rf /tmp/*
+  && rm -rf /tmp/node-compile-cache
 
 ENV YARN_VERSION=1.22.22
 
@@ -103,7 +103,7 @@ RUN apk add --no-cache --virtual .build-deps-yarn curl gnupg tar \
   && apk del .build-deps-yarn \
   # smoke test
   && yarn --version \
-  && rm -rf /tmp/*
+  && rm -rf /tmp/*-compile-cache-*
 
 COPY docker-entrypoint.sh /usr/local/bin/
 ENTRYPOINT ["docker-entrypoint.sh"]
diff --git a/24/alpine3.24/Dockerfile b/24/alpine3.24/Dockerfile
index 848e5430..20443714 100644
--- a/24/alpine3.24/Dockerfile
+++ b/24/alpine3.24/Dockerfile
@@ -77,7 +77,7 @@ RUN addgroup -g 1000 node \
   # smoke tests
   && node --version \
   && npm --version \
-  && rm -rf /tmp/*
+  && rm -rf /tmp/node-compile-cache
 
 ENV YARN_VERSION=1.22.22
 
@@ -103,7 +103,7 @@ RUN apk add --no-cache --virtual .build-deps-yarn curl gnupg tar \
   && apk del .build-deps-yarn \
   # smoke test
   && yarn --version \
-  && rm -rf /tmp/*
+  && rm -rf /tmp/*-compile-cache-*
 
 COPY docker-entrypoint.sh /usr/local/bin/
 ENTRYPOINT ["docker-entrypoint.sh"]
diff --git a/24/bookworm-slim/Dockerfile b/24/bookworm-slim/Dockerfile
index 3023d006..aaa2a129 100644
--- a/24/bookworm-slim/Dockerfile
+++ b/24/bookworm-slim/Dockerfile
@@ -54,7 +54,7 @@ RUN ARCH= OPENSSL_ARCH= && dpkgArch="$(dpkg --print-architecture)" \
     # smoke tests
     && node --version \
     && npm --version \
-    && rm -rf /tmp/*
+    && rm -rf /tmp/node-compile-cache
 
 ENV YARN_VERSION=1.22.22
 
@@ -92,7 +92,7 @@ RUN set -ex \
   && apt-get purge -y --auto-remove -o APT::AutoRemove::RecommendsImportant=false \
   # smoke test
   && yarn --version \
-  && rm -rf /tmp/*
+  && rm -rf /tmp/*-compile-cache-*
 
 COPY docker-entrypoint.sh /usr/local/bin/
 ENTRYPOINT ["docker-entrypoint.sh"]
